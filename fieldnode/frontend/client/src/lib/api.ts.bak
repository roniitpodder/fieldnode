/**
 * FieldNode API client.
 *
 * In dev, Vite proxies /api and /ws to the FastAPI server (see vite.config.ts).
 * In production the FastAPI app serves the built frontend, so a relative base
 * works there too. Override with VITE_API_BASE if you host them separately.
 */

export const API_BASE = (import.meta.env.VITE_API_BASE ?? "").replace(/\/+$/, "");

const TOKEN_KEY = "fieldnode_token";

export function getToken(): string | null {
  try {
    return localStorage.getItem(TOKEN_KEY);
  } catch {
    return null;
  }
}

export function setToken(token: string | null) {
  try {
    if (token) localStorage.setItem(TOKEN_KEY, token);
    else localStorage.removeItem(TOKEN_KEY);
  } catch {
    /* storage unavailable (private mode) — session stays in memory only */
  }
}

export class ApiError extends Error {
  status: number;
  constructor(status: number, message: string) {
    super(message);
    this.status = status;
    this.name = "ApiError";
  }
}

type RequestOptions = {
  method?: string;
  body?: unknown;
  form?: Record<string, string>;
  auth?: boolean;
};

async function request<T>(path: string, options: RequestOptions = {}): Promise<T> {
  const { method = "GET", body, form, auth = true } = options;
  const headers: Record<string, string> = {};

  if (auth) {
    const token = getToken();
    if (token) headers.Authorization = `Bearer ${token}`;
  }

  let payload: BodyInit | undefined;
  if (form) {
    headers["Content-Type"] = "application/x-www-form-urlencoded";
    payload = new URLSearchParams(form).toString();
  } else if (body !== undefined) {
    headers["Content-Type"] = "application/json";
    payload = JSON.stringify(body);
  }

  let response: Response;
  try {
    response = await fetch(`${API_BASE}${path}`, { method, headers, body: payload });
  } catch {
    throw new ApiError(0, "Cannot reach the FieldNode server. Is the backend running on port 8000?");
  }

  if (response.status === 204) return undefined as T;

  const text = await response.text();
  let data: any = null;
  if (text) {
    try {
      data = JSON.parse(text);
    } catch {
      data = text;
    }
  }

  if (!response.ok) {
    let detail = `Request failed (${response.status})`;
    if (typeof data === "string" && data) detail = data;
    else if (data?.detail) {
      detail = typeof data.detail === "string" ? data.detail : JSON.stringify(data.detail);
    }
    throw new ApiError(response.status, detail);
  }

  return data as T;
}

/* ------------------------------------------------------------------ types */

export type User = { id: string; name: string; email: string; language: string };
export type Token = { access_token: string; token_type: string; user: User };

export type Farm = {
  id: string;
  name: string;
  latitude: number | null;
  longitude: number | null;
  created_at: string;
  zone_count: number;
};

export type Zone = {
  id: string;
  farm_id: string;
  name: string;
  soil_type: string;
  crop_preset_id: string | null;
  moisture_threshold_low: number;
  moisture_threshold_high: number;
  auto_mode: boolean;
};

export type CropPreset = {
  id: string;
  crop_name: string;
  moisture_min: number;
  moisture_max: number;
  notes: string | null;
};

export type Device = {
  id: string;
  zone_id: string;
  device_code: string;
  firmware_version: string;
  gsm_fallback_ready: boolean;
  battery_health: number;
  last_seen: string | null;
  is_online: boolean;
  pump_running: boolean;
  pump_flow_rate_lpm: number;
  api_key: string | null;
};

export type SensorReading = {
  id: string;
  device_id: string;
  timestamp: string;
  soil_moisture: number | null;
  temperature: number | null;
  humidity: number | null;
  light_level: number | null;
  rain_detected: boolean | null;
  rain_intensity: number | null;
  sensor_fault: boolean;
};

export type RainSensorStatus = "dry" | "wet" | "suspect_stuck" | "offline" | "no_data";

export type ZoneOverview = {
  zone_id: string;
  zone_name: string;
  soil_moisture: number | null;
  soil_moisture_delta_vs_yesterday: number | null;
  temperature: number | null;
  feels_like: number | null;
  water_used_today_liters: number;
  water_used_delta_vs_fixed_schedule_pct: number | null;
  field_health_score: number;
  sensors_reporting_pct: number;
  device_online: boolean;
  rain_protection_on: boolean;
  rain_probability: number | null;
  raining_now: boolean;
  rain_sensor_status: RainSensorStatus;
  rain_forecast_source: string | null;
  next_cycle_skipped: boolean;
  pump_running: boolean;
  auto_mode: boolean;
};

export type WateringEvent = {
  id: string;
  zone_id: string;
  device_id: string | null;
  timestamp: string;
  trigger_type: string;
  amount_liters: number;
  duration_seconds: number;
  reason: string | null;
};

export type Schedule = {
  id: string;
  zone_id: string;
  next_run_at: string;
  recurrence: string;
  is_auto_generated: boolean;
  rain_skip: boolean;
  rain_probability: number | null;
  reasoning: string | null;
  predicted_liters: number | null;
  status: string;
};

export type AdvisorResult = {
  zone_id: string;
  should_water: boolean;
  recommended_time: string;
  predicted_liters: number;
  recommended_duration_seconds: number | null;
  rain_probability: number;
  rain_skip: boolean;
  raining_now: boolean;
  rain_forecast_source: string;
  confidence: number;
  reasoning: string;
  warnings: string[];
};

export type AnalyticsPoint = {
  timestamp: string;
  soil_moisture: number | null;
  temperature: number | null;
  water_used_liters: number | null;
};

export type Notification = {
  id: string;
  type: string;
  message: string;
  read: boolean;
  created_at: string;
};

export type SuggestedAction = {
  type: string;
  zone_id: string;
  duration_seconds: number;
  liters: number;
  label: string;
};

export type ChatResponse = {
  reply: string;
  suggested_action: SuggestedAction | null;
  degraded: boolean;
  model: string | null;
};

export type ChatMessage = {
  id: string;
  role: string;
  content: string;
  created_at: string;
};

/* --------------------------------------------------------------- endpoints */

export const api = {
  /* auth */
  login: (email: string, password: string) =>
    request<Token>("/api/auth/login", {
      method: "POST",
      auth: false,
      // FastAPI's OAuth2PasswordRequestForm expects form fields, and carries
      // the email in `username`.
      form: { username: email, password },
    }),

  register: (name: string, email: string, password: string, language = "en") =>
    request<Token>("/api/auth/register", {
      method: "POST",
      auth: false,
      body: { name, email, password, language },
    }),

  me: () => request<User>("/api/auth/me"),

  /* farms & zones */
  listFarms: () => request<Farm[]>("/api/farms"),
  createFarm: (name: string, latitude?: number, longitude?: number) =>
    request<Farm>("/api/farms", { method: "POST", body: { name, latitude, longitude } }),

  listZones: (farmId?: string) =>
    request<Zone[]>(`/api/zones${farmId ? `?farm_id=${encodeURIComponent(farmId)}` : ""}`),
  createZone: (payload: {
    farm_id: string;
    name: string;
    soil_type?: string;
    crop_preset_id?: string | null;
    moisture_threshold_low?: number;
    moisture_threshold_high?: number;
    auto_mode?: boolean;
  }) => request<Zone>("/api/zones", { method: "POST", body: payload }),
  updateZone: (zoneId: string, payload: Partial<Omit<Zone, "id" | "farm_id" | "soil_type">>) =>
    request<Zone>(`/api/zones/${zoneId}`, { method: "PATCH", body: payload }),
  deleteZone: (zoneId: string) => request<{ ok: boolean }>(`/api/zones/${zoneId}`, { method: "DELETE" }),

  /* crops */
  listCrops: () => request<CropPreset[]>("/api/crops"),
  createCrop: (payload: { crop_name: string; moisture_min: number; moisture_max: number; notes?: string }) =>
    request<CropPreset>("/api/crops", { method: "POST", body: payload }),

  /* devices */
  listDevices: (zoneId?: string) =>
    request<Device[]>(`/api/devices${zoneId ? `?zone_id=${encodeURIComponent(zoneId)}` : ""}`),
  updateDevice: (deviceId: string, payload: { pump_flow_rate_lpm?: number; firmware_version?: string }) =>
    request<Device>(`/api/devices/${deviceId}`, { method: "PATCH", body: payload }),

  /* telemetry */
  zoneOverview: (zoneId: string) => request<ZoneOverview>(`/api/overview/zones/${zoneId}`),
  zoneReadings: (zoneId: string, hours = 24) =>
    request<SensorReading[]>(`/api/zones/${zoneId}/readings?hours=${hours}`),
  latestReading: (zoneId: string) => request<SensorReading>(`/api/zones/${zoneId}/readings/latest`),
  zoneTrends: (zoneId: string, days = 7) =>
    request<AnalyticsPoint[]>(`/api/analytics/zones/${zoneId}/trends?days=${days}`),

  /* pump */
  controlPump: (zoneId: string, action: "start" | "stop", durationSeconds?: number) =>
    request<WateringEvent>("/api/pump/control", {
      method: "POST",
      body: { zone_id: zoneId, action, duration_seconds: durationSeconds ?? 30 },
    }),
  pumpEvents: (zoneId: string, limit = 50) =>
    request<WateringEvent[]>(`/api/pump/events?zone_id=${zoneId}&limit=${limit}`),

  /* activity & notifications */
  activity: (zoneId?: string, limit = 100) =>
    request<WateringEvent[]>(
      `/api/activity?limit=${limit}${zoneId ? `&zone_id=${encodeURIComponent(zoneId)}` : ""}`,
    ),
  notifications: (unreadOnly = false) =>
    request<Notification[]>(`/api/notifications?unread_only=${unreadOnly}`),
  markAllNotificationsRead: () => request<{ ok: boolean }>("/api/notifications/read-all", { method: "POST" }),

  /* schedules */
  listSchedules: (zoneId: string) => request<Schedule[]>(`/api/schedules?zone_id=${zoneId}`),
  createSchedule: (zoneId: string, nextRunAt: string, recurrence = "daily") =>
    request<Schedule>("/api/schedules", {
      method: "POST",
      body: { zone_id: zoneId, next_run_at: nextRunAt, recurrence },
    }),
  cancelSchedule: (scheduleId: string) =>
    request<Schedule>(`/api/schedules/${scheduleId}/cancel`, { method: "POST" }),

  /* AI advisor */
  advise: (zoneId: string, rainOverride?: number) =>
    request<AdvisorResult>("/api/ai/advise", {
      method: "POST",
      body: { zone_id: zoneId, rain_probability_override: rainOverride ?? null },
    }),
  generateSchedule: (zoneId: string, rainOverride?: number) =>
    request<Schedule>("/api/ai/generate-schedule", {
      method: "POST",
      body: { zone_id: zoneId, rain_probability_override: rainOverride ?? null },
    }),

  /* AI chat */
  chat: (zoneId: string, message: string) =>
    request<ChatResponse>("/api/ai/chat", { method: "POST", body: { zone_id: zoneId, message } }),
  chatHistory: (zoneId: string, limit = 50) =>
    request<ChatMessage[]>(`/api/ai/chat/history?zone_id=${zoneId}&limit=${limit}`),
  clearChatHistory: (zoneId: string) =>
    request<{ ok: boolean }>(`/api/ai/chat/history?zone_id=${zoneId}`, { method: "DELETE" }),
};

/** WebSocket URL for live telemetry. The browser can't set an Authorization
 *  header on a handshake, so the backend takes the JWT as a query param. */
export function zoneSocketUrl(zoneId: string): string | null {
  const token = getToken();
  if (!token) return null;
  const base = API_BASE || window.location.origin;
  const url = new URL(`/ws/zones/${zoneId}`, base);
  url.protocol = url.protocol === "https:" ? "wss:" : "ws:";
  url.searchParams.set("token", token);
  return url.toString();
}
