# Where the FastAPI backend runs. Used by the Vite dev proxy (see vite.config.ts).
VITE_BACKEND_URL=http://127.0.0.1:8000

# Only needed if the built frontend is hosted on a DIFFERENT origin from the API.
# Leave empty when the backend serves the build, or when using the dev proxy.
# VITE_API_BASE=https://api.example.com
