# Copy to .env and adjust for your deployment.
DATABASE_URL=sqlite:///./fieldnode.db
# For Postgres in production: postgresql://user:password@host:5432/fieldnode
SECRET_KEY=change-this-to-a-long-random-string

# --- Optional tuning (defaults shown) ---
# Pump output in L/min. Calibrate: run pump 60 s into a jug (see README).
PUMP_DEFAULT_FLOW_LPM=1.2
# Max seconds for one pump run (replaces the old tank-level dry-run block).
MAX_PUMP_RUN_SECONDS=300
# Rain plate wet continuously this long => treated as stuck/corroded.
RAIN_SENSOR_STUCK_HOURS=12
# Set to false in real use so the advisor never decides on a simulated rain forecast.
USE_MOCK_RAIN_FALLBACK=true

# --- AI chat assistant (Groq) ---
# Free key: https://console.groq.com/keys   (never commit your real key)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Used automatically if the main model is rate-limited (limits are per model).
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Max chat messages per user per minute (protects your Groq quota).
CHAT_RATE_LIMIT_PER_MIN=15
